cabal-version:      3.0
name:               spool
version:            0.0.1
build-type:         Simple
synopsis:           A standalone file-backed JSONL task spool
description:        Builds spool as a native executable with no runtime compiler or source-tree dependency.
category:           Development
maintainer:         space-panda-dev
license:            AGPL-3.0-or-later
license-file:       LICENSES/AGPL-3.0-or-later.txt
copyright:          Spool contributors

flag werror
  description: Treat warnings as errors. The flake and CI turn it on.
  default:     False
  manual:      True

common shared
  default-language: Haskell2010
  build-depends:    base >=4.18 && <5
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages
  if flag(werror)
    ghc-options:    -Werror

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      Spool
    , Spool.Access
    , Spool.Attachments
    , Spool.Canonical
    , Spool.Cli
    , Spool.Error
    , Spool.Files
    , Spool.Grants
    , Spool.Input
    , Spool.Store
    , Spool.Types
    , Spool.Wire
    , Spool.Worker.Config
    , Spool.Worker.Run
  build-depends:
      aeson      >=2.2    && <2.4
    , async      >=2.2    && <2.3
    , bytestring >=0.11   && <0.13
    , containers >=0.6    && <0.9
      -- 2.1.3 as published does not build: its C sources want a header
      -- the tarball does not carry.
    , crypton    (>=1.0   && <2.1.3) || (>2.1.3 && <2.2)
    , directory  >=1.3.8  && <1.4
    , filepath   >=1.4    && <1.6
    , memory     >=0.18   && <0.19
    , process    >=1.6.17 && <1.7
    , stm        >=2.5    && <2.6
    , text       >=2.0    && <2.2
    , time       >=1.12   && <1.16
    , unix       >=2.8    && <2.9

executable spool
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    spool
  ghc-options:      -threaded

test-suite spool-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
      Test.Access
    , Test.Attachments
    , Test.Cli
    , Test.Error
    , Test.Types
    , Test.Wire
    , Test.WorkerConfig
  build-depends:
      spool
    , aeson
    , bytestring
    , containers
    , directory
    , filepath
    , process
    , tasty            >=1.4  && <1.6
    , tasty-hunit      >=0.10 && <0.11
    , tasty-quickcheck >=0.10 && <0.12
    , text
    , unix
  ghc-options:      -threaded
